# Ollama endpoint and model configuration
# Locally, default to http://localhost:11434
# On Render, set OLLAMA_BASE_URL to a separately hosted, reachable HTTPS Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional server-side Bearer token / API key for authenticating to a remote Ollama proxy/endpoint
# Keep exclusively on the backend; never expose to the browser
OLLAMA_API_KEY=

# Mandatory privacy settings: disable LangChain / LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGSMITH_TRACING=false
