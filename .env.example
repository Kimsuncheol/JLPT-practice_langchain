# Direct Ollama Cloud access (no local Ollama installation required)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Create a key at https://ollama.com/settings/keys
# Set only in .env or the deployment backend environment; never commit a real key
OLLAMA_API_KEY=

# Detailed explanations need room for the answer and three follow-up questions.
WORD_NUM_PREDICT=8192
WORD_TIMEOUT_SECONDS=90

# Mandatory privacy settings: disable LangChain / LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGSMITH_TRACING=false
